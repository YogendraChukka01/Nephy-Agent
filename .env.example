# ------------------------------------------------------------------
# Leazed AI — environment template
#
# The current app is a client-side demo: API credentials are entered
# in the in-app Settings panel and stored in localStorage only.
# No environment variables are required to run it.
#
# For a PRODUCTION deployment, proxy all /chat/completions traffic
# through a backend and set the provider credentials server-side.
# Example values below document that future architecture.
# ------------------------------------------------------------------

# PORT for the static dev server (server.js)
PORT=3000

# --- Production proxy configuration (future / not yet read by the app) ---
# VITE_AI_PROXY=/api/v1
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER_API_KEY=sk-REPLACE_ME
# AI_MODEL=gpt-4o